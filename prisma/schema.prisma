generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?
  normalizedNickname String? @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  votes         Vote[]
  voteBallots   VoteBallot[]
  preferences   UserGamePreference[]
  messages      SessionMessage[]
  gameProposals SessionGameProposal[]
  pointBids     PointBid[]
  pointLedger   PriorityPointLedger[]
  participations VotingSessionParticipant[] @relation("ParticipantUser")
  sentInvitations VotingSessionParticipant[] @relation("InvitationSender")
  vetoSnapshots VotingSessionVetoSnapshot[]
  notifications UserNotification[] @relation("NotificationRecipient")
  triggeredNotifications UserNotification[] @relation("NotificationActor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id            String   @id @default(cuid())
  bggId         Int      @unique
  name          String
  yearPublished Int?
  imageUrl      String?
  thumbnailUrl  String?
  minPlayers    Int?
  maxPlayers    Int?
  playingTime   Int?
  averageWeight Float?
  categories    String[] @default([])
  mechanisms    String[] @default([])
  families      String[] @default([])
  designers     String[] @default([])
  artists       String[] @default([])
  metadataJson  String?
  active        Boolean  @default(true)
  isExpansion   Boolean  @default(false)
  parentGameId  String?
  parentGame    Game?    @relation("GameExpansions", fields: [parentGameId], references: [id])
  expansions    Game[]   @relation("GameExpansions")
  importedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  votes         Vote[]
  voteAllocations VoteAllocation[]
  sessionOptions VotingSessionGameOption[]
  sessionProposals SessionGameProposal[]
  pointBids     PointBid[]
  priorityPointLedger PriorityPointLedger[]
  playedInSessions VotingSession[] @relation("VotingSessionPlayedGame")
  preferences   UserGamePreference[]
  vetoSnapshots VotingSessionVetoSnapshot[]

  @@index([active, name])
  @@index([parentGameId])
}

model CatalogSyncRun {
  id             String    @id @default(cuid())
  sourceUsername String
  status         String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  importedCount  Int       @default(0)
  activeCount    Int       @default(0)
  error          String?

  @@index([startedAt])
}

model Location {
  id              String          @id @default(cuid())
  name            String
  address         String
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        VotingSession[]

  @@index([name])
}

model VotingSession {
  id              String   @id @default(cuid())
  localDate       String
  defaultDailyKey String?  @unique
  localStartTime  String?
  localEndTime    String?
  title           String?
  notes           String?
  status          String   @default("open")
  allowPlayerProposals Boolean @default(true)
  proposalsLockedAt DateTime?
  playedGameId    String?
  pointsSettledAt DateTime?
  locationId      String?
  createdByUserId String?
  updatedByUserId String?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  location        Location? @relation(fields: [locationId], references: [id])
  playedGame      Game? @relation("VotingSessionPlayedGame", fields: [playedGameId], references: [id])
  votes           Vote[]
  voteBallots     VoteBallot[]
  gameOptions     VotingSessionGameOption[]
  gameProposals   SessionGameProposal[]
  messages        SessionMessage[]
  pointBids       PointBid[]
  pointLedger     PriorityPointLedger[]
  participants    VotingSessionParticipant[]
  vetoSnapshots   VotingSessionVetoSnapshot[]
  notifications   UserNotification[]

  @@index([localDate, localStartTime])
  @@index([status])
  @@index([locationId])
  @@index([playedGameId])
}

model SessionMessage {
  id              String        @id @default(cuid())
  votingSessionId String
  userId          String
  content         String
  createdAt       DateTime      @default(now())
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   UserNotification[]

  @@index([votingSessionId, createdAt])
  @@index([userId])
}

model Vote {
  id              String        @id @default(cuid())
  votingSessionId String
  userId          String
  gameId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id])

  @@unique([votingSessionId, userId])
  @@index([gameId])
  @@index([userId])
}

model VoteBallot {
  id              String        @id @default(cuid())
  votingSessionId String
  userId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations     VoteAllocation[]
  pointBid        PointBid?

  @@unique([votingSessionId, userId])
  @@index([userId])
}

model VoteAllocation {
  id        String     @id @default(cuid())
  ballotId  String
  gameId    String
  voteCount Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  ballot    VoteBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  game      Game       @relation(fields: [gameId], references: [id])

  @@unique([ballotId, gameId])
  @@index([gameId])
}

model VotingSessionGameOption {
  id              String        @id @default(cuid())
  votingSessionId String
  gameId          String
  addedByUserId   String?
  source          String        @default("creator")
  createdAt       DateTime      @default(now())
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id])

  @@unique([votingSessionId, gameId])
  @@index([gameId])
  @@index([addedByUserId])
  @@index([source])
}

model SessionGameProposal {
  id              String        @id @default(cuid())
  votingSessionId String
  userId          String
  gameId          String
  isPriority      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id])

  @@unique([votingSessionId, userId, gameId])
  @@index([votingSessionId, userId, isPriority])
  @@index([gameId])
}

model PointBid {
  id              String        @id @default(cuid())
  ballotId        String        @unique
  votingSessionId String
  userId          String
  gameId          String
  points          Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ballot          VoteBallot    @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id])

  @@index([votingSessionId])
  @@index([userId])
  @@index([gameId])
}

model PriorityPointLedger {
  id              String   @id @default(cuid())
  userId          String
  votingSessionId String?
  gameId          String?
  amount          Int
  reason          String
  idempotencyKey  String   @unique
  createdByUserId String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votingSession   VotingSession? @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  game            Game?    @relation(fields: [gameId], references: [id])
  notifications   UserNotification[]

  @@index([userId, createdAt])
  @@index([votingSessionId])
  @@index([gameId])
  @@index([reason])
}

model UserGamePreference {
  id         String   @id @default(cuid())
  userId     String
  gameId     String
  preference String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([preference])
}

model VotingSessionParticipant {
  id                  String        @id @default(cuid())
  votingSessionId     String
  userId              String
  invitedByUserId     String?
  status              String        @default("invited")
  invitedAt           DateTime      @default(now())
  respondedAt         DateTime?
  attendanceUpdatedAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  votingSession       VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user                User          @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy           User?         @relation("InvitationSender", fields: [invitedByUserId], references: [id])

  @@unique([votingSessionId, userId])
  @@index([userId, status])
  @@index([votingSessionId, status])
  @@index([invitedByUserId])
}

model VotingSessionVetoSnapshot {
  id              String        @id @default(cuid())
  votingSessionId String
  userId          String
  gameId          String
  source          String
  capturedAt      DateTime      @default(now())
  votingSession   VotingSession @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id])

  @@unique([votingSessionId, userId, gameId])
  @@index([votingSessionId, gameId])
  @@index([userId])
}

model UserNotification {
  id                String               @id @default(cuid())
  userId            String
  type              String
  title             String
  body              String?
  href              String?
  actorUserId       String?
  votingSessionId   String?
  sessionMessageId  String?
  ledgerEntryId     String?
  dedupeKey         String?
  readAt            DateTime?
  createdAt         DateTime             @default(now())
  user              User                 @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorUser         User?                @relation("NotificationActor", fields: [actorUserId], references: [id])
  votingSession     VotingSession?       @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  sessionMessage    SessionMessage?      @relation(fields: [sessionMessageId], references: [id], onDelete: Cascade)
  ledgerEntry       PriorityPointLedger? @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([votingSessionId])
  @@index([sessionMessageId])
  @@index([ledgerEntryId])
  @@index([dedupeKey])
}
